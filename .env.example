# Auth: comma-separated API keys. Leave empty to disable auth (local dev only).
API_KEYS=change-me-1,change-me-2

# SET upstream (override if SET changes its endpoints)
SET_BASE_URL=https://www.set.or.th
SET_CORPORATE_ACTION_PATH=/api/set/stock/{symbol}/corporate-action
SET_PROFILE_PATH=/api/set/stock/{symbol}/profile

# Tuning
SET_TIMEOUT_SECONDS=10
SET_MAX_RETRIES=2
SET_MAX_CONCURRENCY=4
CACHE_TTL_SECONDS=600
MAX_SYMBOLS=50
